# Legacy manual publishing script configuration. Never commit real values.
# The Windows desktop publisher stores its OAuth tokens in Windows Credential
# Manager and does not read this file. GitHub Actions no longer posts to SNS.

# Public site URL used in social posts when an article has no external link
SITE_URL=https://www.student-b.com

# --- X (Twitter) — OAuth 1.0a user context (Read + Write) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Facebook Page — Meta Graph API ---
# Create a Meta app, get a long-lived Page access token with pages_manage_posts
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- LinkedIn Company Page ---
# Create a LinkedIn app, complete OAuth, use a token with w_organization_social
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
# Example: urn:li:organization:123456789
